# 复制为 .env 后按需修改。默认使用 Docker MySQL。
# 生产环境必须改为 DEV_MODE=0，并填写正式小程序 AppID / AppSecret / 提醒模板。
DEV_MODE=1
PORT=8787
BIND_HOST=0.0.0.0
RELEASE_VERSION=dev
REQUEST_BODY_LIMIT=128kb
REQUIRE_HTTPS=0
HEALTH_DETAILS=1
WX_APPID=
WX_SECRET=
# 生产必须填写；只支持你在小程序后台申请并配置字段的订阅消息模板。
WX_REMINDER_TEMPLATE_ID=
WX_REMINDER_PAGE=pages/plan/plan
WX_HTTP_TIMEOUT_MS=10000
REMINDER_RETENTION_DAYS=90
BACKUP_RETENTION_DAYS=30
STORAGE_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=13306
DB_NAME=life_workbench
DB_USER=root
DB_PASSWORD=
DB_POOL_SIZE=5
# 本地开发允许自动建库和执行迁移；生产环境应关闭并由独立迁移账号执行一次。
DB_AUTO_CREATE=1
DB_RUN_MIGRATIONS=1
# token 有效天数（滑动续期）
TOKEN_TTL_DAYS=30
# 生产环境填写允许跨域访问的前端 HTTPS 域名，多个用英文逗号分隔；小程序原生请求没有 Origin，不受影响。
CORS_ALLOWED_ORIGINS=
# Caddy/nginx 反代部署时设为 1，速率限制才能正确识别真实客户端 IP；直连本机时保持 0。
TRUST_PROXY=0
# 接口速率限制
API_RATE_LIMIT=240
RECORD_WRITE_RATE_LIMIT=120
LOGIN_RATE_LIMIT=30
REMINDER_RATE_LIMIT=30
ACCOUNT_DELETE_RATE_LIMIT=5
# 仅本地调试使用：若配置，可用 phoneCode=dev-phone 模拟一次手机号绑定；生产不要配置
DEV_PHONE_NUMBER=

# AI 洞察：密钥通过 secret:set:docker 写入数据库，不要把 API Key 放进代码或此文件。
AI_ENABLED=1
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_MAX_TOKENS=160
AI_TIMEOUT_MS=12000
# 本地可留空并使用 DB_PASSWORD 派生；生产必须填写独立随机值。
AI_SECRET_ENCRYPTION_KEY=
AI_INSIGHT_RATE_LIMIT=10

# 生产覆盖示例（不要与上面的 DEV_MODE=1 同时保留两行）：
# DEV_MODE=0
# BIND_HOST=127.0.0.1
# REQUIRE_HTTPS=1
# DB_AUTO_CREATE=0
# DB_RUN_MIGRATIONS=0
# BACKUP_RETENTION_DAYS=30
# CORS_ALLOWED_ORIGINS=https://www.your-domain.com
