# 正式服务器模板：复制为 .env 后填入真实值。请勿提交实际密钥。
DEV_MODE=0
PORT=8787
# Node 仅由本机 Caddy/Nginx 反代，不直接暴露 8787。
BIND_HOST=127.0.0.1
RELEASE_VERSION=replace-before-release
REQUEST_BODY_LIMIT=128kb
REQUIRE_HTTPS=1
HEALTH_DETAILS=0

# 小程序后台「开发管理 → 开发设置」中的正式凭证。
WX_APPID=
WX_SECRET=
# 已配置 thing1（事项）和 time2（时间）字段的订阅消息模板 ID。
WX_REMINDER_TEMPLATE_ID=
WX_REMINDER_PAGE=pages/plan/plan
WX_HTTP_TIMEOUT_MS=10000
REMINDER_RETENTION_DAYS=90
BACKUP_RETENTION_DAYS=30

STORAGE_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=life_workbench
DB_USER=life_sync
DB_PASSWORD=
DB_POOL_SIZE=10
# 生产服务账号不应有建库/DDL 权限。首次上线由独立迁移账号执行 db:migrate 后保持 0。
DB_AUTO_CREATE=0
DB_RUN_MIGRATIONS=0
TOKEN_TTL_DAYS=30

# 给未来网页端使用；小程序原生请求没有 Origin，不受此项影响。
CORS_ALLOWED_ORIGINS=https://www.example.com
# Caddy/nginx 反代时必须开启，否则限流会把所有请求视为同一个代理 IP。
TRUST_PROXY=1
API_RATE_LIMIT=240
RECORD_WRITE_RATE_LIMIT=120
LOGIN_RATE_LIMIT=30
REMINDER_RATE_LIMIT=30
ACCOUNT_DELETE_RATE_LIMIT=5

# AI 洞察。API Key 不放在环境变量，使用 `npm run secret:set` 写入 app_secrets。
AI_ENABLED=1
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash
AI_MAX_TOKENS=160
AI_TIMEOUT_MS=12000
# 建议生产填写独立随机值；修改后需重新写入/迁移 app_secrets 中的密文。
AI_SECRET_ENCRYPTION_KEY=
AI_INSIGHT_RATE_LIMIT=10
