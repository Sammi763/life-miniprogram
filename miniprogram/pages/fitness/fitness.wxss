.hero-values { display: flex; justify-content: space-around; text-align: center; }
.hero-values view { display: flex; flex-direction: column; }
.hero-values > view > text { color: var(--terra); font-size: 46rpx; font-weight: 600; margin-top: 6rpx; }
.hero-values > view > text:last-child { color: var(--ink-2); font-size: 22rpx; }
.bmi-thin { color: #378ADD !important; }.bmi-normal { color: var(--green) !important; }.bmi-over { color: var(--amber) !important; }.bmi-high { color: var(--red) !important; }
.target-line { display: flex; justify-content: space-between; color: var(--ink-2); font-size: 24rpx; margin-top: 28rpx; }
.weight-chart { width: 100%; height: 360rpx; display: block; }
.range-tabs { display: flex; gap: 20rpx; color: var(--ink-2); font-size: 24rpx; font-weight: 400; }.range-tabs .on { color: var(--terra); font-weight: 600; }
.chart-legend { display: flex; justify-content: center; gap: 32rpx; color: var(--ink-2); font-size: 22rpx; }.legend-item { display: flex; align-items: center; }.legend-item > view { width: 24rpx; height: 4rpx; margin: 0 8rpx 0 0; background: var(--terra); }.legend-item .legend-average { background: var(--ink-2); }
.quick-actions { display: flex; gap: 20rpx; padding: 0 24rpx 24rpx; }.quick-actions .btn { flex: 1; min-height: 76rpx; font-size: 26rpx; }
.deficit-row, .exercise-row, .weight-row { display: flex; align-items: center; padding: 18rpx 0; border-top: 1rpx solid var(--line); gap: 14rpx; font-size: 24rpx; }.deficit-row > text:nth-child(2) { flex: 1; color: var(--ink-2); }.deficit-row > text:nth-child(3) { width: 100rpx; text-align: right; }.delete-action { color: var(--ink-2); font-size: 20rpx; padding-left: 6rpx; }
.exercise-check { width: 42rpx; height: 42rpx; border: 2rpx solid var(--line); border-radius: 12rpx; color: transparent; display: flex; justify-content: center; align-items: center; flex-shrink: 0; }.exercise-check-on { color: #fff; background: var(--green); border-color: var(--green); }.exercise-main { display: flex; gap: 20rpx; flex: 1; }.exercise-main text:first-child { color: var(--terra); width: 64rpx; }.plan-done { color: var(--ink-2); text-decoration: line-through; }.weight-value { color: var(--terra); font-size: 30rpx; font-weight: 600; }.weight-row { gap: 18rpx; }.weight-row > text:first-child { width: 150rpx; }.weight-row .sub { flex: 1; }
.switch-row { display: flex; align-items: center; justify-content: space-between; margin: 12rpx 0 28rpx; }
