.report-head { display: flex; align-items: center; justify-content: center; gap: 42rpx; padding: 28rpx 0 12rpx; }
.report-arrow { width:64rpx; height:64rpx; border-radius:50%; background:var(--surface); border:1rpx solid var(--line); display:flex; align-items:center; justify-content:center; color:var(--accent); font-size:42rpx; }
.report-arrow-disabled { opacity: .35; }
.privacy-note { text-align: center; color: var(--ink-2); font-size: 22rpx; margin-bottom: 24rpx; }
.finance-hero { color:#F8FCF8; background:linear-gradient(135deg, var(--hero-start), var(--hero-end)); border:0; box-shadow:0 18rpx 38rpx var(--hero-shadow); }.finance-hero .card-title, .finance-hero .sub { color:rgba(248,252,248,.78); }.finance-hero .balance, .finance-hero .money-in, .finance-hero .money-out { color:#FFF; }.finance-hero .budget-block { border-color:rgba(255,255,255,.18); }
.balance { font-size: 64rpx; font-weight: 600; color: var(--terra); margin: 12rpx 0 26rpx; }
.finance-grid { display: flex; gap: 24rpx; }
.finance-grid > view { flex: 1; }
.finance-number { margin: 8rpx 0; font-size: 34rpx; font-weight: 600; }
.budget-block { margin-top:28rpx; padding-top:24rpx; border-top:1rpx solid var(--line); }
.budget-row { display: flex; justify-content: space-between; font-size: 24rpx; margin-bottom: 12rpx; }
.budget-empty { margin-top: 18rpx; }
.rank-row { display: flex; align-items: center; padding: 18rpx 0; border-top: 1rpx solid var(--line); }
.rank-number { width: 42rpx; height: 42rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--terra-soft); color: var(--terra); font-size: 22rpx; margin-right: 18rpx; }
.rank-name { flex: 1; }
.trend-row { display: flex; align-items: center; gap: 14rpx; padding: 12rpx 0; }
.trend-day { width: 54rpx; color: var(--ink-2); font-size: 23rpx; }
.trend-track { flex:1; height:18rpx; background:var(--accent-soft); overflow:hidden; border-radius:9rpx; }
.trend-fill { height: 100%; min-width: 0; background: var(--terra); border-radius: 9rpx; }
.trend-amount { width: 106rpx; text-align: right; font-size: 24rpx; }
.category-budget-row { display: flex; justify-content: space-between; padding: 20rpx 0; border-top: 1rpx solid var(--line); }
.category-budget-side { text-align: right; }
.budget-over { color: var(--danger); }
.memory-month-row { display: flex; gap: 34rpx; align-items: center; }
.memory-month-copy { flex: 1; min-width: 0; line-height: 2; }
.month-tag { display: inline-block; color: var(--terra); margin-left: 10rpx; }
.section-label { margin: 36rpx 8rpx 16rpx; font-size: 32rpx; font-weight: 600; }
.life-grid { display: grid; grid-template-columns: 1fr 1fr; padding: 0; overflow: hidden; }
.life-cell { min-height: 170rpx; padding: 26rpx; border-right: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); }
.life-cell:nth-child(2n) { border-right: none; }
.life-cell:nth-last-child(-n+2) { border-bottom: none; }
.life-value { margin: 10rpx 0 6rpx; color: var(--terra); font-size: 42rpx; font-weight: 600; }
.life-value text { color: var(--ink-2); font-size: 22rpx; font-weight: 400; }
.summary-card { margin-bottom: 36rpx; }
.summary-text { line-height: 1.8; color: var(--ink); }
.summary-note { margin-top: 18rpx; }
