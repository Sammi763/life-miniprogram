.search-head { display:flex; align-items:center; background:var(--surface); border:1rpx solid var(--line); border-radius:18rpx; padding:0 22rpx; margin:8rpx 0 18rpx; }
.search-icon { color:var(--ink-2); font-size:30rpx; margin-right:8rpx; }
.search-head input { flex:1; min-width:0; height:80rpx; font-size:28rpx; }
.search-clear { flex:none; width:44rpx; height:44rpx; display:flex; align-items:center; justify-content:center; color:var(--ink-2); font-size:26rpx; }
.search-filters { white-space:nowrap; margin-bottom:24rpx; }
.search-filter-line { display:inline-flex; gap:14rpx; }
.search-empty { text-align:center; padding:54rpx 30rpx; line-height:2; }
.search-history-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:18rpx; }
.search-history-title { font-size:26rpx; font-weight:600; color:var(--ink); }
.search-history-clear { padding:8rpx 0 8rpx 16rpx; }
.search-count { margin:-8rpx 8rpx 16rpx; }
.search-result { margin-bottom:16rpx; }
.search-result-top { display:flex; justify-content:space-between; margin-bottom:12rpx; }
.search-kind { color:var(--accent); background:var(--accent-soft); border-radius:999rpx; padding:4rpx 12rpx; font-size:22rpx; }.search-title { color:var(--ink); font-size:29rpx; margin-bottom:8rpx; }
/* 关键词命中高亮 */
.search-hit { color:var(--accent); font-weight:700; background:var(--accent-soft); border-radius:6rpx; padding:0 2rpx; }
