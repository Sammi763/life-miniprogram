<view class="theme-page" style="{{themeStyle}}">
<view class="search-head"><input focus="true" value="{{keyword}}" bindinput="onKeyword" placeholder="搜索随记、日程、待买、书影音和账本" maxlength="50" /></view>
<scroll-view scroll-x="true" class="search-filters"><view class="search-filter-line"><view wx:for="{{filters}}" wx:key="key" class="chip {{kind === item.key ? 'on' : ''}}" bindtap="setKind" data-kind="{{item.key}}">{{item.label}}</view></view></scroll-view>
<view wx:if="{{!searched}}" class="card search-empty"><view>想找什么？</view><view class="sub">输入关键词后，只会在你已同步到本机的文字记录中检索。</view></view>
<view wx:if="{{searched && results.length === 0}}" class="card search-empty"><view>没有找到匹配内容</view><view class="sub">试试更短的关键词，或切换分类。</view></view>
<view wx:for="{{results}}" wx:key="key" class="card search-result record-card" hover-class="record-card-pressed" bindtap="openResult" data-id="{{item.id}}" data-kind="{{item.kind}}"><view class="search-result-top"><text class="search-kind">{{item.kindText}}</text><text class="sub">{{item.date}}</text></view><view class="search-title">{{item.title}}</view><view wx:if="{{item.subtitle}}" class="sub">{{item.subtitle}}</view></view>
</view>
