.mine-page { padding:16rpx 0 calc(44rpx + env(safe-area-inset-bottom)); }
.profile-hero { margin:0 24rpx 22rpx; padding:34rpx 32rpx 28rpx; border-radius:30rpx; color:#F8FCF8; background:linear-gradient(135deg, var(--hero-start), var(--hero-end)); box-shadow:0 18rpx 42rpx var(--hero-shadow); }
.profile-main { display:flex; align-items:center; min-width:0; }
.profile-avatar { border-radius:50%; width:104rpx; height:104rpx; flex-shrink:0; font-size:38rpx; box-shadow:inset 0 0 0 6rpx rgba(255,255,255,.35); }
.profile-copy { min-width:0; flex:1; margin-left:20rpx; }
.profile-eyebrow, .section-kicker { color:var(--accent); font-size:20rpx; letter-spacing:2.8rpx; font-weight:700; }
.profile-eyebrow { color:rgba(244,251,246,.68); }
.profile-name { max-width:310rpx; margin:3rpx 0; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; color:#FFF; font-size:35rpx; font-weight:700; }
.profile-edit { padding:10rpx 0 10rpx 18rpx; color:var(--hero-edit); font-size:24rpx; }
.profile-rule { height:1rpx; margin:28rpx 0 20rpx; background:rgba(255,255,255,.17); }
.profile-stats { display:flex; }
.profile-stats > view { flex:1; display:flex; flex-direction:column; gap:4rpx; }
.profile-stats > view + view { padding-left:22rpx; border-left:1rpx solid rgba(255,255,255,.15); }
.profile-stats text:first-child { color:#FFF; font-size:29rpx; font-weight:700; }
.profile-stats text:last-child { color:rgba(244,251,246,.64); font-size:20rpx; }

.section-head { display:flex; align-items:flex-start; justify-content:space-between; }
.section-title { margin-top:3rpx; color:var(--ink); font-size:33rpx; font-weight:700; }
.save-issues .notice-warn { margin-top:16rpx; }

.theme-grid { display:flex; flex-wrap:wrap; gap:16rpx; margin-top:24rpx; }
.theme-option { position:relative; width:calc(50% - 8rpx); min-height:112rpx; box-sizing:border-box; display:flex; align-items:center; padding:16rpx; border:1rpx solid var(--line); border-radius:20rpx; background:var(--surface); }
.theme-option-on { border-color:var(--accent); background:var(--accent-wash); box-shadow:inset 0 0 0 1rpx var(--accent); }
.theme-preview { width:52rpx; height:52rpx; flex-shrink:0; border-radius:16rpx; box-shadow:inset 0 0 0 1rpx rgba(255,255,255,.42); }
.theme-copy { min-width:0; margin-left:14rpx; }.theme-copy > view:first-child { color:var(--ink); font-size:26rpx; font-weight:650; }.theme-copy .sub { margin-top:1rpx; font-size:20rpx; }
.theme-check { position:absolute; top:10rpx; right:10rpx; width:28rpx; height:28rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#FFF; background:var(--accent); font-size:18rpx; font-weight:700; }

.share-card { margin-top:36rpx; padding:0 32rpx; overflow:hidden; }.share-card .section-head { padding:30rpx 0 12rpx; }
.share-note { color:var(--ink-2); font-size:23rpx; line-height:1.65; }
.share-btn { margin:22rpx 0 28rpx; min-height:76rpx; font-size:27rpx; }

.settings-card { margin-top:36rpx; padding:0 32rpx; overflow:hidden; }.settings-card .section-head { padding:30rpx 0 12rpx; }
.setting-row { display:flex; align-items:center; justify-content:space-between; min-height:110rpx; border-top:1rpx solid var(--line); }.setting-row > view:first-child { color:var(--ink); font-size:27rpx; }.setting-row .sub { margin-top:3rpx; }.setting-row > text { color:#A3ADA6; font-size:38rpx; }.setting-danger > view:first-child, .setting-danger > text { color:var(--red); }.logout-entry { padding:24rpx 0 30rpx; text-align:center; color:var(--ink-2); font-size:25rpx; }
.ai-setting switch { transform:scale(.86); transform-origin:right center; }
/* 导入备份恢复弹层 */
.import-textarea { width: 100%; min-height: 180rpx; font-size: 24rpx; padding: 16rpx; box-sizing: border-box; border: 1rpx solid var(--line); border-radius: 12rpx; background: var(--surface); }
.import-preview { border: 1rpx solid var(--line); border-radius: 14rpx; padding: 18rpx 20rpx; margin-bottom: 20rpx; background: var(--surface); }
.import-preview-title { font-weight: 600; margin-bottom: 10rpx; }
.import-preview-row { display: flex; justify-content: space-between; gap: 12rpx; }
.import-preview-coll { margin-top: 8rpx; }
.import-note { margin-top: 12rpx; }
.import-actions { display: flex; gap: 16rpx; }
.import-actions .btn { flex: 1; }
/* 提醒设置弹层（v2.11）：续订按钮与说明 */
.reminder-renew { min-height: 64rpx; font-size: 26rpx; padding: 0 28rpx; display: flex; align-items: center; }
.reminder-note { margin-top: 8rpx; }


/* 合并缺失记录操作说明 */
.import-semantic-note { padding: 0 4rpx 14rpx; line-height: 1.6; }
