<view class="mine-page theme-page" style="{{themeStyle}}">
  <view class="profile-hero">
    <view class="profile-main">
      <image wx:if="{{avatarPath}}" class="profile-avatar" src="{{avatarPath}}" mode="aspectFill" binderror="avatarError" />
      <view wx:else class="profile-avatar text-avatar {{profile.avatarTone}}">{{profile.avatarText}}</view>
      <view class="profile-copy">
        <view class="profile-eyebrow">MY LIFE SPACE</view>
        <view class="profile-name">{{profile.nickname}}</view>
      </view>
      <view class="profile-edit tap-row" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90" bindtap="editProfile">编辑</view>
    </view>
    <view class="profile-rule"></view>
    <view class="profile-stats">
      <view><text>{{recordCount}}</text><text>已记录</text></view>
      <view><text>{{activeDays}}</text><text>记录天数</text></view>
    </view>
  </view>

  <view wx:if="{{cacheError || rejectedCount}}" class="card save-issues">
    <view class="section-title">记录保存异常</view>
    <view wx:if="{{cacheError}}" class="notice-warn notice-warn-row"><text class="notice-text">{{cacheError}}</text><view class="notice-action tap-row" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90" bindtap="openDataSheet">处理</view></view>
    <view wx:if="{{rejectedCount}}" class="notice-warn notice-warn-row"><text class="notice-text">{{rejectedText}}</text><view class="notice-action tap-row" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90" bindtap="retryRejected">重试</view></view>
  </view>

  <!--
    U03 设置收纳：预算编辑已迁回「记账」页；主题收成一行入口；
    这里提供提醒、合规与数据管理入口。
  -->
  <view class="card settings-card">
    <view class="section-head"><view><view class="section-kicker">SETTINGS</view><view class="section-title">设置</view></view></view>
    <view class="setting-row tap-row" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90" bindtap="openThemeSheet"><view><view>界面主题</view><view class="sub">{{themeName}} · 五套配色与跟随系统</view></view><text>›</text></view>
    <view wx:if="{{showPersonalizedAi}}" class="setting-row ai-setting"><view><view>个性化 AI 文案</view><view class="sub">默认关闭，开启前会说明数据范围</view></view><switch checked="{{aiConsent}}" color="{{themeAccent}}" bindchange="onAiConsentChange" /></view>
    <view class="setting-row tap-row" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90" bindtap="openReminderSheet"><view><view>提醒设置</view><view class="sub">打卡与还款订阅消息的额度与续订</view></view><text>›</text></view>
    <view class="setting-row tap-row" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90" bindtap="goLegal" data-doc="privacy"><view><view>隐私与合规</view><view class="sub">隐私政策 · 服务协议 · 第三方说明</view></view><text>›</text></view>
    <view class="setting-row tap-row" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90" bindtap="openDataSheet"><view><view>数据管理</view><view class="sub">导出备份、合并缺失记录</view></view><text>›</text></view>
  </view>

  <view class="card share-card">
    <view class="section-head"><view><view class="section-kicker">INVITE</view><view class="section-title">邀请朋友一起用</view></view><text class="sub">卡片不含你的记录</text></view>
    <view class="share-note">转发出去的是应用本身。对方点开后在各自的账号里使用，看不到你的账本、习惯或随记。</view>
    <button class="btn btn-ghost share-btn" open-type="share">转发给微信好友</button>
  </view>

  <!-- 账号相关单独成卡：删除与退出都不可逆，不该和普通设置挤在同一张卡里 -->
  <view class="card account-card">
    <view class="section-head"><view><view class="section-kicker">ACCOUNT</view><view class="section-title">账号</view></view><text class="sub">不可恢复的操作</text></view>
    <view class="setting-row setting-danger tap-row" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90" bindtap="deleteAccount"><view><view>永久删除账户与数据</view><view class="sub">删除前会要求一次新的微信登录校验</view></view><text>{{deletingAccount ? '处理中' : '›'}}</text></view>
    <view class="logout-entry tap-row" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90" bindtap="logout">退出当前账号</view>
  </view>

  <!-- 低频运维项收进弹层（Tab 页弹层由 attachOverlayWatcher 自动隐藏悬浮导航） -->
  <view wx:if="{{dataSheetShow}}" class="mask" bindtap="closeDataSheet"></view>
  <view wx:if="{{dataSheetShow}}" class="sheet" catchtap="noop">
    <view class="sheet-title">数据管理</view>
    <view wx:if="{{cacheError}}" class="sub">本机缓存占用 {{cacheText}}</view>
    <view wx:if="{{issueText}}" class="notice-warn">{{issueText}}</view>
    <view class="setting-row tap-row" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90" bindtap="exportFromServer"><view><view>导出账号备份</view><view class="sub">含记录 ID 的 JSON 副本（v1），可用于恢复</view></view><text>›</text></view>
    <view class="setting-row tap-row" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90" bindtap="copyBackup"><view><view>复制本机备份</view><view class="sub">含记录 ID 与删除记录，剪贴板交付</view></view><text>›</text></view>
    <view class="setting-row tap-row" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90" bindtap="openImportSheet"><view><view>合并缺失记录</view><view class="sub">粘贴备份 JSON，只补缺、不覆盖、不恢复已删除</view></view><text>›</text></view>
    <view class="setting-row tap-row" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90" bindtap="exportMoneyCsv"><view><view>导出账本 CSV</view><view class="sub">仅记账流水，可粘贴到 Excel / 表格</view></view><text>›</text></view>
    <view class="setting-row tap-row" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90" bindtap="rebuildLocalCache"><view><view>重建本机缓存</view><view class="sub">用于修复本机缓存异常</view></view><text>›</text></view>
    <view wx:if="{{showDemoControls}}" class="setting-row tap-row" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90" bindtap="clearDemo"><view><view>清理示例内容</view><view class="sub">不会影响自己添加的记录</view></view><text>›</text></view>
  </view>

  <!-- 主题弹层（U03）：从整卡收纳为一行入口 -->
  <view wx:if="{{themeSheetShow}}" class="mask" bindtap="closeThemeSheet"></view>
  <view wx:if="{{themeSheetShow}}" class="sheet" catchtap="noop">
    <view class="sheet-title">界面主题</view>
    <view class="theme-grid">
      <view wx:for="{{themeOptions}}" wx:key="id" class="theme-option tap-row {{item.selected ? 'theme-option-on' : ''}}" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90" bindtap="onThemeSelect" data-theme="{{item.id}}">
        <view class="theme-preview" style="background: {{item.preview}};"></view>
        <view class="theme-copy"><view>{{item.name}}</view><view class="sub">{{item.detail}}</view></view>
        <view wx:if="{{item.selected}}" class="theme-check">✓</view>
      </view>
    </view>
  </view>

  <!-- 提醒设置（v2.11 提醒矩阵）：额度展示 + 续订；开关本体在习惯页/记账页，这里不新增页面 -->
  <view wx:if="{{reminderSheetShow}}" class="mask" bindtap="closeReminderSheet"></view>
  <view wx:if="{{reminderSheetShow}}" class="sheet" catchtap="noop">
    <view class="sheet-title">提醒设置</view>
    <view class="setting-row"><view><view>习惯打卡提醒</view><view class="sub">{{reminderHabitText}}</view></view><button class="btn btn-ghost reminder-renew" bindtap="onReminderRenew" data-kind="habit" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90">续订</button></view>
    <view class="setting-row"><view><view>账单还款提醒</view><view class="sub">{{reminderBillText}}</view></view><button class="btn btn-ghost reminder-renew" bindtap="onReminderRenew" data-kind="bill" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90">续订</button></view>
    <button class="btn btn-ghost" bindtap="openReminderCenter" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90">查看提醒记录</button>
    <view class="sub reminder-note">开关在「习惯」页与「记账」页设置；一次订阅授权对应一次提醒送达，额度用完后可在此续订。</view>
  </view>

  <!-- 合并缺失记录（U10）：粘贴 JSON → 解析预览 → 确认；只补缺、不覆盖、不复活已删除记录 -->
  <view wx:if="{{importSheetShow}}" class="mask" bindtap="closeImportSheet"></view>
  <view wx:if="{{importSheetShow}}" class="sheet import-sheet" catchtap="noop">
    <view class="sheet-title">合并缺失记录</view>
    <view class="sub import-semantic-note">这里只把备份中本机没有的记录补进来：不会覆盖现有内容，也不会恢复你已删除的记录（备份里带删除标记的数据一律跳过）。</view>
    <view class="field">
      <view class="field-label">粘贴备份 JSON（导出时复制的完整内容）</view>
      <textarea class="import-textarea" value="{{importText}}" bindinput="onImportText" maxlength="-1" placeholder='以 {"format":"life-backup"...} 开头的 JSON' auto-height />
    </view>
    <view wx:if="{{importPreview && !importPreview.ok}}" class="notice-warn">{{importPreview.message}}</view>
    <view wx:if="{{importPreview && importPreview.ok}}" class="import-preview">
      <view class="import-preview-title">预览（共 {{importPreview.total}} 条）</view>
      <view class="import-preview-row"><text>将新建 {{importPreview.create}} 条</text><text class="sub">已存在保留现值 {{importPreview.skipLive}} 条</text></view>
      <view class="import-preview-row"><text class="sub">已删除保持删除 {{importPreview.skipDeleted}} 条</text><text class="sub">备份中已删除（不恢复）{{importPreview.skipBackupDeleted}} 条</text></view>
      <view class="import-preview-row"><text class="sub">无效跳过 {{importPreview.invalidCount}} 条</text></view>
      <view wx:for="{{importPreview.byCollection}}" wx:key="coll" class="import-preview-coll sub">{{item.coll}}：新建 {{item.create}} · 保留 {{item.skipLive}} · 删除保留 {{item.skipDeleted}} · 备份已删 {{item.skipBackupDeleted}} · 无效 {{item.invalid}}</view>
      <view wx:if="{{importPreview.roundedMoneyRecords}}" class="import-preview-row"><text>将有 {{importPreview.roundedMoneyRecords}} 条记录的金额自动取到分</text></view>
      <view wx:for="{{importPreview.moneyDifferences}}" wx:key="month" class="import-preview-coll sub">{{item.month}} 相较旧汇总 {{item.text}}</view>
      <view wx:if="{{importPreview.invalidSample.length}}" class="notice-warn">{{importPreview.invalidSample[0]}}</view>
      <view wx:if="{{importPreview.localWriteCount}}" class="notice-warn">
        <view>备份另存了 {{importPreview.localWriteCount}} 条未同步或被拒的改动。可复制原文，核对后手动补录。</view>
        <button class="btn btn-ghost" bindtap="copyImportLocalWrites" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90">复制改动原文</button>
      </view>
      <view class="sub import-note">提醒授权与 AI 同意不随备份恢复：恢复后需重新开启；账号里已有的同 ID 记录会保留，可重复导入。</view>
    </view>
    <view class="import-actions">
      <button class="btn btn-ghost" bindtap="parseImport" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90">解析预览</button>
      <button class="btn btn-primary" disabled="{{!importPreview || !importPreview.ok || !importPreview.create || importBusy}}" bindtap="confirmImport" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90">{{importBusy ? '恢复中…' : '确认合并'}}</button>
    </view>
  </view>

  <view class="tabbar-spacer"></view>
</view>
