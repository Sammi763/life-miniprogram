.theme-page { padding-top:30rpx; }
.today-hero { margin: 0 24rpx 20rpx; padding: 34rpx 32rpx 26rpx; border-radius: 32rpx; color: #F7FCF8; background: linear-gradient(140deg, var(--hero-start) 0%, var(--hero-end) 100%); box-shadow: 0 20rpx 44rpx var(--hero-shadow); }
.hero-date { margin-top:4rpx; font-size:30rpx; font-weight:600; }
.hero-focus { display:flex; align-items:center; justify-content:space-between; padding:22rpx 0 0; border-top:1rpx solid rgba(255,255,255,.18); }
.hero-focus-label { color:rgba(247,252,248,.58); font-size:21rpx; }
.hero-focus-title { margin-top:2rpx; font-size:29rpx; font-weight:600; }
.hero-focus-sub { color:rgba(247,252,248,.62); font-size:22rpx; }
.hero-focus-action { min-width:86rpx; padding:10rpx 18rpx; border-radius:999rpx; text-align:center; background:var(--hero-soft); color:var(--hero-soft-ink); font-size:23rpx; font-weight:600; }
.today-memory-entry { display:flex; align-items:center; justify-content:space-between; background:var(--accent-wash); border:1rpx solid var(--line); }
.today-memory-title { color:var(--ink); font-size:34rpx; font-weight:700; margin-bottom:6rpx; }.today-memory-plus { width:58rpx; height:58rpx; line-height:54rpx; text-align:center; border-radius:50%; color:#FFF; background:var(--accent); font-size:42rpx; box-shadow:0 8rpx 14rpx rgba(49,92,82,.2); }
.quick-grid { display:flex; flex-wrap:wrap; gap:16rpx; }.quick-item { position:relative; width:calc(50% - 8rpx); box-sizing:border-box; padding:22rpx; border:1rpx solid var(--line); border-radius:18rpx; background:var(--surface); display:flex; flex-direction:column; }
.quick-item > text:nth-child(2) { font-size: 28rpx; font-weight: 600; margin-top: 10rpx; }
.quick-item > .sub { margin-top: 4rpx; }
.quick-icon { width:48rpx; height:48rpx; border-radius:14rpx; display:flex; justify-content:center; align-items:center; background:var(--accent-soft); color:var(--accent); font-size:28rpx; }
.quick-plus { position: absolute; right: 18rpx; top: 42rpx; color: var(--terra); font-size: 30rpx; }
.budget-big { font-size: 52rpx; font-weight: 600; color: var(--red); margin: 10rpx 0; }
.recent-row { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid var(--line); }
.recent-row:last-child { border-bottom: none; }
.recent-main { flex: 1; min-width: 0; }
.recent-main > view:first-child { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.recent-row > text { margin-left: 20rpx; font-size: 28rpx; }
.quote { font-size: 30rpx; line-height: 1.7; margin-bottom: 10rpx; }

.money-row { display: flex; }
.money-cell { flex: 1; }
.money-num { font-size: 44rpx; font-weight: 600; margin-top: 6rpx; }
.today-bill-row { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 0; border-top: 1rpx solid var(--line); }

.budget { margin-top: 24rpx; }
.bar {
  height: 14rpx;
  border-radius: 999rpx;
  background: var(--line);
  margin-top: 12rpx;
  overflow: hidden;
}
.bar-fill { height: 100%; background: var(--terra); border-radius: 999rpx; }
.bar-hot { background: var(--red); }

.today-queue-row { display: flex; align-items: center; min-height: 92rpx; border-top: 1rpx solid var(--line); }
.queue-main { display: flex; align-items: center; flex: 1; min-width: 0; padding: 14rpx 0; }
.queue-kind { flex-shrink:0; width:58rpx; padding:7rpx 0; margin-right:16rpx; border-radius:10rpx; text-align:center; color:var(--ink-2); background:var(--surface); font-size:20rpx; }
.queue-kind-on { color: var(--terra); background: var(--terra-soft); }
.queue-copy { flex: 1; min-width: 0; }
.queue-copy > view:first-child { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
/* 独立「完成」按钮：与查看详情分离（U08），保持 88rpx 级热区 */
.queue-done { flex-shrink: 0; margin-left: 16rpx; padding: 10rpx 24rpx; border-radius: 999rpx; color: var(--terra); background: var(--terra-soft); font-size: 24rpx; }
/* 置顶独立热区：加左边框分隔 + 加大触控面积，避免误触 */
.queue-pin { flex-shrink:0; margin-left:16rpx; padding:20rpx 0 20rpx 22rpx; border-left:1rpx solid var(--line); color:var(--ink-2); font-size:22rpx; }
.queue-overdue { color: var(--red); }
.value-steps { margin-bottom: 26rpx; }
.hero-queue { display: flex; align-items: center; min-height: 76rpx; margin-top: 12rpx; font-size: 30rpx; font-weight: 600; }
.quick-habit, .queue-expand { margin-top: 16rpx; font-size: 26rpx; }
/* 今日待处理卡：逾期徽标 */
.title-side { display: flex; align-items: center; gap: 14rpx; }
.overdue-badge {
  font-size: 20rpx; color: var(--red);
  background: var(--danger-soft);
  border-radius: 8rpx; padding: 2rpx 10rpx;
}
/* 本月支出卡：预算行可点进入「我的」设置 */
.budget-tap { display: flex; justify-content: space-between; align-items: center; margin-top: 6rpx; }
.budget-tap-hint { font-size: 22rpx; color: var(--ink-2); }

.life-tools-trigger { margin: 0; padding: 0 6rpx 0 16rpx; min-height: 56rpx; line-height: 56rpx; border-radius: 10rpx; background: transparent; }
.life-tools-trigger::after, .life-tool::after { border: 0; }
.life-tools-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.life-tool { display: flex; align-items: center; gap: 12rpx; width: 100%; min-height: 100rpx; margin: 0; padding: 14rpx; box-sizing: border-box; border: 1rpx solid var(--line); border-radius: 18rpx; background: var(--surface); color: var(--ink); text-align: left; font-size: 26rpx; line-height: 1.4; }
.life-tool-glyph { display: flex; flex: 0 0 48rpx; align-items: center; justify-content: center; height: 48rpx; border-radius: 14rpx; background: var(--accent-soft); color: var(--accent); font-weight: 700; }
.life-tool-copy { min-width: 0; }
.life-tool-copy > view:first-child { font-weight: 600; }
.life-tools-close { margin-top: 20rpx; }
