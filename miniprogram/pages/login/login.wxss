.login-page { position:relative; min-height:100vh; overflow:hidden; padding:76rpx 24rpx 52rpx; box-sizing:border-box; }
.login-orb { position:absolute; width:360rpx; height:360rpx; border-radius:50%; filter:blur(2rpx); opacity:.62; pointer-events:none; }
.login-orb-one { top:-168rpx; right:-124rpx; background:var(--accent-soft); }
.login-orb-two { top:360rpx; left:-230rpx; background:var(--accent-wash); }
.brand-block { position:relative; text-align:center; margin:0 0 50rpx; }
.brand-logo-wrap { width:192rpx; height:192rpx; margin:0 auto 22rpx; display:flex; align-items:center; justify-content:center; border-radius:42rpx; background:var(--card); box-shadow:0 18rpx 48rpx var(--shadow-color); }
.brand-logo { display:block; width:176rpx; height:176rpx; }
.brand-kicker, .login-kicker { color:var(--accent); font-size:20rpx; letter-spacing:3rpx; font-weight:700; }
.brand-title { margin-top:8rpx; color:var(--ink); font-size:42rpx; line-height:1.35; font-weight:700; letter-spacing:1rpx; }
.brand-sub { color:var(--ink-2); font-size:25rpx; margin-top:10rpx; }
.login-card, .profile-card { position:relative; padding:38rpx 34rpx 34rpx; background:var(--card); }
.login-title, .profile-title { margin:10rpx 0 14rpx; color:var(--ink); font-size:38rpx; line-height:1.3; font-weight:700; }
.login-status { margin:-12rpx 0 22rpx; color:var(--accent); font-size:24rpx; line-height:1.6; }
.server-error { margin:-6rpx 0 24rpx; padding:16rpx 20rpx; border-radius:16rpx; background:var(--danger-soft); color:var(--red); font-size:24rpx; line-height:1.6; }
.terms-group { margin:-4rpx 0 22rpx; }
.terms-row { display:flex; align-items:flex-start; color:var(--ink-2); font-size:22rpx; line-height:1.7; }
.terms-row checkbox { flex-shrink:0; transform:scale(.78); transform-origin:left top; margin:4rpx 0 0 -8rpx; }
.terms-copy { flex:1; padding-top:1rpx; }
.terms-link { color:var(--accent); font-weight:600; }
.terms-hint { margin:-10rpx 0 18rpx; color:var(--amber); font-size:22rpx; }
.login-btn, .complete-btn { margin:0; }
.login-trust { display:flex; align-items:center; justify-content:center; gap:10rpx; margin-top:24rpx; color:var(--accent); font-size:24rpx; }
.diagnose-block { margin-top:20rpx; }
.diagnose-result { margin-bottom:16rpx; padding:16rpx 20rpx; border-radius:16rpx; font-size:23rpx; line-height:1.65; }
.diagnose-ok { background:var(--accent-soft); color:var(--accent); }
.diagnose-bad { background:var(--warn-soft); color:var(--amber); }
.diagnose-btn { min-height:72rpx; font-size:26rpx; }
.diagnose-version { margin-top:12rpx; text-align:center; color:var(--ink-2); font-size:21rpx; letter-spacing:.5rpx; }
.trust-dot { width:12rpx; height:12rpx; border-radius:50%; background:var(--accent); }
.privacy-copy { margin-top:18rpx; line-height:1.7; text-align:center; }
.profile-card-head { display:flex; align-items:flex-start; justify-content:space-between; margin-bottom:14rpx; }
.avatar-area { display:flex; flex-direction:column; align-items:center; margin:12rpx 0 32rpx; }
.avatar { width:148rpx; height:148rpx; margin-bottom:16rpx; font-size:50rpx; box-shadow:inset 0 0 0 8rpx rgba(255,255,255,.5); }
.field { margin-bottom:26rpx; }
/* 会话校验期间的静默过渡态：替代「登录卡闪现后跳转」 */
.entering { position:relative; display:flex; flex-direction:column; align-items:center; padding:180rpx 0 0; }
.entering-logo { width:120rpx; height:120rpx; display:flex; align-items:center; justify-content:center; border-radius:30rpx; background:var(--card); box-shadow:0 18rpx 48rpx var(--shadow-color); animation:entering-pulse 1.2s ease-in-out infinite; }
.entering-logo-img { width:100rpx; height:100rpx; }
.entering-text { margin-top:26rpx; color:var(--ink-2); font-size:25rpx; }
@keyframes entering-pulse { 0%, 100% { transform:scale(1); opacity:1; } 50% { transform:scale(.96); opacity:.82; } }

.avatar-area .avatar { flex-shrink: 0; border-radius: 50%; }
.avatar-area .btn { margin: 10rpx 0; }
