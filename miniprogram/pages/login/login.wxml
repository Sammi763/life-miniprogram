<view class="login-page theme-page" style="{{themeStyle}}">
  <view class="login-orb login-orb-one"></view>
  <view class="login-orb login-orb-two"></view>
  <view class="brand-block">
    <view class="brand-logo-wrap"><image class="brand-logo" src="/assets/logo.png" mode="aspectFit"></image></view>
    <view class="brand-kicker">LIFE NOTES</view>
    <view class="brand-title">生活记忆 life</view>
    <view class="brand-sub">把生活，慢慢放回自己的手里</view>
  </view>

  <view class="card login-card" wx:if="{{!loggedIn && !entering}}">
    <view class="login-kicker">YOUR PRIVATE SPACE</view>
    <view class="login-title">把生活留给自己</view>
    <view wx:if="{{loginStatus}}" class="login-status">{{loginStatus}}</view>
    <view wx:if="{{serverError}}" class="server-error">{{serverError}}</view>
    <checkbox-group class="terms-group" bindchange="onTermsChange">
      <label class="terms-row">
        <checkbox value="accepted" checked="{{termsAccepted}}" color="{{themeAccent}}" />
        <view class="terms-copy">我已阅读并同意<text class="terms-link" catchtap="openLegal" data-doc="service">《用户服务协议》</text>和<text class="terms-link" catchtap="openLegal" data-doc="privacy">《隐私政策》</text></view>
      </label>
    </checkbox-group>
    <view wx:if="{{existingSessionNeedsTerms}}" class="terms-hint">已验证当前账号，请确认协议后继续使用。</view>
    <button class="btn btn-primary login-btn" loading="{{loggingIn}}" disabled="{{loggingIn}}" bindtap="onLogin" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90">{{loginFailed ? '重新登录' : '微信登录并开始'}}</button>
    <view wx:if="{{loginFailed}}" class="diagnose-block">
      <view wx:if="{{diagnostic}}" class="diagnose-result {{diagnosticFailed ? 'diagnose-bad' : 'diagnose-ok'}}">{{diagnostic}}</view>
      <view class="btn btn-ghost diagnose-btn" bindtap="onDiagnose" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90">{{diagnosing ? '自检中…' : '网络自检'}}</view>
      <view class="diagnose-version">当前版本 {{buildVersion}}</view>
    </view>
    <view class="login-trust"><text class="trust-dot"></text><text>你的记录仅用于你的生活空间</text></view>
    <view class="sub privacy-copy">昵称可选。</view>
  </view>

  <view class="card profile-card" wx:elif="{{loggedIn}}">
    <view class="profile-card-head"><view><view class="login-kicker">PROFILE</view><view class="profile-title">编辑资料</view></view><text class="sub">可选</text></view>
    <view class="avatar-area">
      <image wx:if="{{avatarPath}}" class="avatar" src="{{avatarPath}}" mode="aspectFill" binderror="avatarError" />
      <view wx:else class="avatar text-avatar {{avatarTone}}">{{avatarText}}</view>
      <button wx:if="{{avatarEnabled}}" class="btn btn-ghost" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" disabled="{{saving}}" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90">选择头像</button>
      <button wx:if="{{avatarEnabled && hasAvatar}}" class="btn btn-ghost" bindtap="resetAvatar" disabled="{{saving}}" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90">恢复文字头像</button>
      <view class="sub">文字头像会随昵称自动生成，昵称可以留空</view>
    </view>
    <view class="field">
      <view class="field-label">昵称</view>
      <input type="text" maxlength="32" value="{{nickname}}" bindinput="onNickname" placeholder="请输入昵称" />
    </view>
    <button class="btn btn-primary complete-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="completeProfile" hover-class="tap-pressed" hover-start-time="20" hover-stay-time="90">保存资料</button>
  </view>

  <view class="entering" wx:else>
    <view class="entering-logo"><image class="entering-logo-img" src="/assets/logo.png" mode="aspectFit"></image></view>
    <view class="entering-text">正在进入生活记忆…</view>
  </view>
</view>
