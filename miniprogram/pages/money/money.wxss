.fab { bottom: calc(164rpx + env(safe-area-inset-bottom)); z-index: 101; }

.mon-head {
  display: flex; align-items: center; justify-content: center;
  gap: 40rpx; padding: 32rpx 0 20rpx;
}
.mon-arrow {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: var(--surface); border: 1rpx solid var(--line);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; color: var(--ink-2);
}
.report-entry { display:flex; justify-content:space-between; align-items:center; margin:0 24rpx 20rpx; padding:20rpx 24rpx; border-radius:18rpx; color:var(--accent); background:var(--accent-wash); font-size:26rpx; }
.report-entry text:last-child { font-size: 22rpx; color: var(--ink-2); }

.account-card { padding-bottom: 20rpx; }
.account-add { color: var(--terra) !important; white-space: nowrap; }
.networth-row { display: flex; justify-content: space-between; align-items: flex-end; padding: 4rpx 0 22rpx; }
.networth-num { font-size: 54rpx; font-weight: 650; color: var(--ink); letter-spacing: 1rpx; }
.account-count { text-align: right; color: var(--ink-2); font-size: 24rpx; }
.account-totals { display: flex; gap: 20rpx; padding: 20rpx 0; border-top: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); }
.account-totals > view { flex: 1; }
.account-totals > view + view { border-left: 1rpx solid var(--line); padding-left: 24rpx; }
.account-totals .money-in, .account-totals .money-out { font-size: 30rpx; font-weight: 600; margin-top: 4rpx; }
.account-list { margin-top: 4rpx; }
.account-item { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }
.account-item:last-child { border-bottom: none; }
.account-monogram { width:72rpx; height:72rpx; flex-shrink:0; border-radius:20rpx; background:var(--green-soft); color:var(--green); display:flex; align-items:center; justify-content:center; font-size:24rpx; font-weight:600; margin-right:18rpx; }.account-monogram.debt { background:#F8E8E7; color:var(--red); }
.account-copy { flex: 1; overflow: hidden; }
.account-copy > view:first-child { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.account-bill { color: var(--red); font-size: 21rpx; margin-top: 4rpx; }
.account-amount { flex-shrink: 0; margin-left: 16rpx; font-size: 30rpx; font-weight: 600; }
.account-empty { color: var(--ink-2); font-size: 24rpx; padding: 24rpx 0 10rpx; }
.account-hint { color: var(--ink-2); font-size: 21rpx; margin-top: 14rpx; }

.mon-sum { display: flex; margin-bottom: 8rpx; }
.mon-cell { flex: 1; }
.money-num { font-size: 44rpx; font-weight: 600; margin-top: 6rpx; }
.money-transfer { color:#67756D; }
.transfer-note { display: block; margin-top: 10rpx; line-height: 1.5; }
.money-color-note { display: flex; gap: 20rpx; margin-top: 8rpx; font-size: 21rpx; }
.mon-chips { margin-top: 20rpx; }

.mon-date {
  display: flex; justify-content: space-between;
  font-size: 26rpx; color: var(--ink-2); margin-bottom: 8rpx;
}
.mon-item {
  display: flex; align-items: center;
  padding: 20rpx 0; border-bottom: 1rpx solid var(--line);
}
.mon-item:last-child { border-bottom: none; }
.mon-cat {
  width: 88rpx; height: 88rpx; border-radius: 20rpx;
  background: var(--terra-soft); color: var(--terra);
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; margin-right: 20rpx; flex-shrink: 0;
  text-align: center; line-height: 1.3; padding: 0 8rpx;
}
.transfer-cat { background:#EDF0EC; color:#68746D; }
.mon-mid { flex: 1; overflow: hidden; }
.mon-mid > view:first-child {
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.mon-amt { font-size: 30rpx; font-weight: 600; flex-shrink: 0; margin-left: 16rpx; }
.category-chips { max-height: 280rpx; overflow-y: auto; padding-right: 4rpx; }

.account-sheet { max-height: 82vh; overflow-y: auto; box-sizing: border-box; }
.account-presets { display: flex; flex-wrap: wrap; gap: 12rpx; }
.account-preset { width:calc(33.333% - 8rpx); min-height:68rpx; box-sizing:border-box; padding:8rpx 10rpx; border-radius:14rpx; border:1rpx solid var(--line); background:var(--surface); display:flex; flex-direction:column; justify-content:center; align-items:center; color:var(--ink-2); font-size:22rpx; line-height:1.3; }
.account-preset.on { border-color: var(--terra); background: var(--terra-soft); color: var(--terra); }
.preset-kind { font-size: 19rpx; color: var(--ink-2); margin-top: 2rpx; }
.account-preset.on .preset-kind { color: var(--terra); }
.bill-alert { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-top: 1rpx solid var(--line); }
.bill-amount { text-align: right; }
.inline-field { display: flex; gap: 24rpx; }
.inline-field > view { flex: 1; min-width: 0; }
