.summary { display: flex; justify-content: space-around; text-align: center; }
.summary-num { font-size: 48rpx; font-weight: 600; color: var(--terra); margin-top: 8rpx; }
.summary-num text { font-size: 24rpx; font-weight: 400; color: var(--ink-2); }
.plan-bill-row { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 0; border-top: 1rpx solid var(--line); }
.calendar { padding: 24rpx 20rpx; }
.calendar-head { height: 64rpx; display: flex; align-items: center; justify-content: space-between; }
.calendar-arrow { width: 64rpx; text-align: center; font-size: 48rpx; line-height: 56rpx; color: var(--terra); }
.calendar-period { flex: 1; text-align: center; font-weight: 600; font-size: 28rpx; }
.today-link { color: var(--terra); font-size: 22rpx; margin-left: 8rpx; }
.week-grid { display: flex; justify-content: space-between; padding-top: 18rpx; }
.week-day { width: 13.5%; display: flex; flex-direction: column; align-items: center; padding: 10rpx 0; border-radius: 18rpx; }
.week-day-selected { background:var(--accent-soft); border:1rpx solid var(--accent); }
.week-name { font-size: 20rpx; color: var(--ink-2); }
.week-number { margin-top: 8rpx; width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 28rpx; font-weight: 500; }
.week-day-selected .week-number { font-weight: 700; }
.week-number-today { background: var(--terra); color: #fff; }
.week-dot { min-width: 46rpx; height: 26rpx; margin-top: 8rpx; text-align: center; color: transparent; font-size: 20rpx; line-height: 26rpx; border-radius: 13rpx; }
.week-dot-on { color:var(--accent); background:var(--accent-soft); }
.section-title { display: flex; justify-content: space-between; margin: 36rpx 8rpx 16rpx; font-size: 32rpx; font-weight: 600; }
.plan-row { display: flex; align-items: flex-start; margin-bottom: 16rpx; }
.plan-check { width: 44rpx; height: 44rpx; border: 2rpx solid var(--line); border-radius: 12rpx; color: transparent; display: flex; align-items: center; justify-content: center; font-size: 26rpx; margin-right: 20rpx; margin-top: 4rpx; flex-shrink: 0; }
.plan-check-on { background: var(--green); border-color: var(--green); color: #fff; }
.plan-check-skip { border-color:#B4BEB7; color:var(--ink-2); }
.plan-content { flex: 1; min-width: 0; }
.plan-title { font-size: 30rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.plan-done { color: var(--ink-2); text-decoration: line-through; }
.row-overdue .plan-title { color: var(--red); }
.row-skipped { background:var(--surface); }
.repeat-tag, .reminder-tag, .overdue-tag, .skip-tag { margin-left: 10rpx; padding: 2rpx 10rpx; border-radius: 8rpx; font-size: 20rpx; }
.repeat-tag { color:var(--accent); background:var(--accent-soft); }.reminder-tag { color:var(--amber); background:var(--warn-soft); }.overdue-tag { color:var(--red); background:var(--danger-soft); }.skip-tag { color:var(--ink-2); background:var(--surface); }
.more-action { color: var(--ink-2); font-size: 30rpx; padding: 0 4rpx 10rpx 20rpx; line-height: 34rpx; }
.time-field { position: relative; }
.clear-time { position: absolute; right: 24rpx; bottom: 28rpx; color: var(--terra); font-size: 24rpx; }
.reminder-switch { border-top: 1rpx solid var(--line); padding-top: 24rpx; }
.series-hint { margin: -8rpx 0 22rpx; padding: 14rpx 18rpx; border-radius: 14rpx; background: var(--warn-soft); color: var(--amber); font-size: 22rpx; line-height: 1.6; }
.repeat-options { display: flex; gap: 16rpx; }
.repeat-option { flex: 1; text-align: center; border: 1rpx solid var(--line); border-radius: 16rpx; padding: 16rpx 8rpx; color: var(--ink-2); font-size: 26rpx; }
.repeat-option-on { border-color:var(--accent); background:var(--accent-soft); color:var(--accent); font-weight:600; }
.repeat-note { margin: -8rpx 0 24rpx; line-height: 1.55; }

.plan-subtask { padding: 12rpx 0; overflow-wrap: anywhere; }
.plan-subtask .btn { min-width: 0; }
