.fab { bottom: calc(164rpx + env(safe-area-inset-bottom)); z-index: 101; }

.habit-card { position: relative; }
.habit-row { display: flex; align-items: center; }
.habit-info { flex: 1; }
.habit-name { font-size: 30rpx; font-weight: 500; display: flex; align-items: center; gap: 12rpx; }
.habit-streak {
  font-size: 20rpx; font-weight: 400; color: var(--terra);
  background: var(--terra-soft); border-radius: 8rpx; padding: 2rpx 10rpx;
}
.habit-btn {
  padding: 14rpx 30rpx; border-radius: 999rpx;
  background: var(--terra-soft); color: var(--terra); font-size: 26rpx;
}
.habit-btn-on { background: var(--green); color: #fff; }
.habit-bar {
  height: 10rpx; border-radius: 999rpx; background: var(--line);
  margin-top: 20rpx; overflow: hidden;
}
.habit-bar-fill { height: 100%; background: var(--terra); border-radius: 999rpx; }
.habit-edit {
  position: absolute; right: 28rpx; top: 20rpx;
  font-size: 22rpx; color: var(--ink-2); padding: 6rpx 12rpx;
}
