/* 与 report 页的月份切换箭头同规格：圆形描边按钮，而非裸文本 */
.review-head { display:flex; align-items:center; justify-content:space-between; text-align:center; margin:12rpx 0 12rpx; }.review-arrow { width:64rpx; height:64rpx; border-radius:50%; background:var(--surface); border:1rpx solid var(--line); display:flex; align-items:center; justify-content:center; color:var(--accent); font-size:42rpx; line-height:64rpx; box-sizing:border-box; }.review-arrow-disabled { opacity:.35; }.privacy-note { text-align:center; color:var(--ink-2); font-size:23rpx; margin-bottom:22rpx; }
.review-money, .review-grid { display:grid; grid-template-columns:repeat(3, 1fr); gap:16rpx; }
.review-money > view, .review-grid > view { min-width:0; }
.review-money { font-size:32rpx; font-weight:700; }
.review-number { color:var(--ink); font-size:42rpx; font-weight:700; margin:8rpx 0; }
.review-number text { font-size:22rpx; font-weight:400; }
.memory-review { line-height:2; }
.review-tag { display:inline-block; margin-left:12rpx; color:var(--accent); }.next-plan { display:flex; align-items:center; gap:20rpx; padding:18rpx 0; border-top:1rpx solid var(--line); color:var(--ink); }.next-plan text:first-child { color:var(--ink-2); min-width:124rpx; font-size:24rpx; }.next-plan-title { flex:1; min-width:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }.next-plan-arrow { color:var(--ink-2); font-size:32rpx; }

/* U13 复盘闭环：调整转日程/习惯 */
.review-adjust-actions { display: flex; gap: 16rpx; margin: 8rpx 0 14rpx; }
.review-adjust-actions .btn { flex: 1; }
