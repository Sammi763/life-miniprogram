.review-head { display:flex; align-items:center; justify-content:space-between; text-align:center; margin:12rpx 0 12rpx; }.review-arrow { width:62rpx; color:var(--accent); font-size:54rpx; line-height:68rpx; }.review-arrow.disabled { color:#C7D0C9; }.privacy-note { text-align:center; color:var(--ink-2); font-size:23rpx; margin-bottom:22rpx; }
.review-money, .review-grid { display:grid; grid-template-columns:repeat(3, 1fr); gap:16rpx; }
.review-money > view, .review-grid > view { min-width:0; }
.review-money { font-size:32rpx; font-weight:700; }
.review-number { color:var(--ink); font-size:34rpx; font-weight:700; margin:8rpx 0; }
.review-number text { font-size:22rpx; font-weight:400; }
.memory-review { line-height:2; }
.review-tag { display:inline-block; margin-left:12rpx; color:var(--accent); }.next-plan { display:flex; gap:20rpx; padding:18rpx 0; border-top:1rpx solid var(--line); color:var(--ink); }.next-plan text:first-child { color:var(--ink-2); min-width:124rpx; font-size:24rpx; }
