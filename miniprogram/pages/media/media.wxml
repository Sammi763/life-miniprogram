<view class="theme-page" style="{{themeStyle}}">
<view wx:if="{{offline}}" class="banner"><text>云端暂不可用，改动已暂存本机</text><text bindtap="onPullDownRefresh" style="font-weight:600">重试</text></view>

<view class="card year-card">
  <view class="card-title"><text>今年看过</text><text class="more">平均 {{stats.average}} 星</text></view>
  <view class="year-stats"><view><text>{{stats.book}}</text><text>本书</text></view><view><text>{{stats.movie}}</text><text>部影片</text></view><view><text>{{stats.music}}</text><text>张专辑</text></view></view>
</view>

<view class="toolbar">
  <view class="chips media-chips"><view wx:for="{{types}}" wx:key="key" class="chip {{filter === item.key ? 'on' : ''}}" bindtap="setFilter" data-kind="{{item.key}}">{{item.label}}</view></view>
  <view class="view-switch"><text class="{{viewMode === 'grid' ? 'active' : ''}}" bindtap="setView" data-mode="grid">▦</text><text class="{{viewMode === 'list' ? 'active' : ''}}" bindtap="setView" data-mode="list">☰</text></view>
</view>

<view wx:if="{{items.length === 0}}" class="card"><view class="empty">还没有收藏，给未来留一点想看的东西</view></view>
<view wx:if="{{viewMode === 'grid'}}" class="media-grid">
  <view wx:for="{{items}}" wx:key="id" class="media-card card record-card" hover-class="record-card-pressed" bindtap="openEdit" data-id="{{item.id}}">
    <view class="media-monogram {{item.avatarTone}}"><text class="media-kind">{{item.kindText}}</text><text class="media-initial">{{item.avatarText}}</text></view>
    <view class="media-title">{{item.title}}</view>
    <view class="media-meta"><text>{{item.statusText}}</text><text wx:if="{{item.rating}}">{{item.ratingText}}</text></view>
    <view wx:if="{{item.comment}}" class="sub media-comment">{{item.comment}}</view>
    <view class="media-delete" catchtap="remove" data-id="{{item.id}}">删除</view>
  </view>
</view>
<view wx:else class="media-list">
  <view wx:for="{{items}}" wx:key="id" class="card media-list-row record-card" hover-class="record-card-pressed" bindtap="openEdit" data-id="{{item.id}}">
    <view class="list-type {{item.avatarTone}}"><text>{{item.kindText}}</text><text>{{item.avatarText}}</text></view><view class="list-main"><view>{{item.title}}</view><view class="sub">{{item.statusText}}<text wx:if="{{item.rating}}"> · {{item.rating}} 星</text><text wx:if="{{item.comment}}"> · {{item.comment}}</text></view></view><view class="media-delete" catchtap="remove" data-id="{{item.id}}">删除</view>
  </view>
</view>

<view class="fab" bindtap="openAdd">＋</view>
<view wx:if="{{sheetShow}}" class="mask" bindtap="closeSheet"></view>
<view wx:if="{{sheetShow}}" class="sheet" catchtap="noop">
  <view class="sheet-title">{{form.id ? '编辑收藏' : '新增收藏'}}</view>
  <view class="field"><view class="field-label">类型</view><view class="chips"><view wx:for="{{types}}" wx:if="{{item.key}}" wx:key="key" class="chip {{form.kind === item.key ? 'on' : ''}}" bindtap="setKind" data-kind="{{item.key}}">{{item.label}}</view></view></view>
  <view class="field"><view class="field-label">标题</view><input value="{{form.title}}" bindinput="onTitle" maxlength="60" placeholder="如：《小王子》" /></view>
  <view class="field"><view class="field-label">状态</view><view class="chips"><view wx:for="{{statuses}}" wx:key="key" class="chip {{form.status === item.key ? 'on' : ''}}" bindtap="setStatus" data-status="{{item.key}}">{{item.label}}</view></view></view>
  <view class="field"><view class="field-label">评分</view><view class="rating-input"><text wx:for="{{stars}}" wx:key="*this" class="star {{item <= form.rating ? 'star-on' : ''}}" bindtap="setRating" data-rating="{{item}}">★</text></view></view>
  <view class="field"><view class="field-label">记录日期</view><picker mode="date" value="{{form.date}}" bindchange="onDate"><view class="picker-value">{{form.date}}</view></picker></view>
  <view class="field"><view class="field-label">短评</view><textarea value="{{form.comment}}" bindinput="onComment" maxlength="100" placeholder="留下 100 字以内的感受" /></view>
  <button class="btn btn-primary" disabled="{{saving}}" bindtap="save">{{saving ? '保存中…' : '保存'}}</button>
</view>
</view>
