<view class="tabbar-shell {{hidden ? 'tabbar-hidden' : ''}}" style="{{themeStyle}}">
  <view class="tabbar">
    <view wx:for="{{list}}" wx:key="pagePath" class="tab-item {{selected == index ? 'is-selected' : ''}}" hover-class="tab-item-pressed" hover-start-time="20" hover-stay-time="90" bindtap="onTabTap" data-index="{{index}}">
      <view class="tab-icon">{{item.glyph}}<view wx:if="{{badges[index] > 0}}" class="tab-badge">{{badges[index] > 99 ? '99+' : badges[index]}}</view></view>
      <view class="tab-text">{{item.text}}</view>
    </view>
  </view>
</view>
