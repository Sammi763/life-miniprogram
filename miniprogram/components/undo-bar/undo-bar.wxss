/* 底色用 --ink 深色以保证在四套主题下都与页面拉开层级；文字取 --card（各主题均为浅色）。
   不加 CSS animation：fixed 元素 + keyframes 在真机上出现过点击失效的卡死案例（见 app.wxss 说明）。 */
.undo-bar {
  position: fixed; left: 24rpx; right: 24rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  z-index: 105; /* 高于 fab(101)，低于 mask(199)：弹层打开时撤销条应被盖住 */
  display: flex; align-items: center; justify-content: space-between; gap: 20rpx;
  padding: 22rpx 28rpx; border-radius: 22rpx;
  background: var(--ink); color: var(--card);
  box-shadow: 0 12rpx 30rpx var(--sheet-shadow);
}
.undo-bar-raised { bottom: calc(164rpx + env(safe-area-inset-bottom)); }
.undo-text { flex: 1; min-width: 0; font-size: 25rpx; line-height: 1.5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.undo-btn { flex: none; font-size: 27rpx; font-weight: 600; color: var(--accent-soft); padding: 10rpx 12rpx; margin: -10rpx -12rpx; }
.undo-pressed { opacity: .65; }
